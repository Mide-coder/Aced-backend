# ── Environment Configuration ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values
#   cp .env.example .env

ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
# Use SQLite for local development, PostgreSQL for production
DATABASE_URL=sqlite:///./aced.db
# DATABASE_URL=postgresql://user:password@host:5432/aced

# ── JWT — CHANGE THIS in production ──────────────────────────────────────────
JWT_SECRET=your-super-secret-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Paystack (Test Mode) ──────────────────────────────────────────────────────
PAYSTACK_SECRET=sk_test_xxxxxxxxxxxx

# ── Sentry (Free Tier — optional for dev) ─────────────────────────────────────
SENTRY_DSN=

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aced-uploads

# ── Celery / Redis (Upstash Free Tier) [E004-S04] ─────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── WhatsApp Cloud API (Sandbox) [E004-S04] ──────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Frontend URL ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Encryption (Optional — for data at rest) [E008-S01] ───────────────────────
ENCRYPTION_KEY=
